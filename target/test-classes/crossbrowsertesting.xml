<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="crossBrowserAndParallelTestingSuite" thread-count="5" parallel="tests">

<listeners>
        <listener class-name="com.demowebshop.listeners.ExtentReportManager"/>
</listeners>

  <test name="chrometest">
  
  <parameter name="browser" value="chrome"/>
  <parameter name="operatingSystem" value="Windows"/>
  
    <classes>
      <class name="com.hybridframework.practice.scenarios.LoginTest_TC1"/>
      <class name="com.hybridframework.practice.scenarios.RegisterTest_TC2"/>
      <class name="com.hybridframework.practice.scenarios.SearchTest_TC3"/>
    </classes>
    
  </test> <!-- Test -->
  
  <test name="firefoxtest">
  
  <parameter name="browser" value="firefox"/>
  <parameter name="operatingSystem" value="Windows"/>
  
    <classes>
      <class name="com.hybridframework.practice.scenarios.LoginTest_TC1"/>
      <class name="com.hybridframework.practice.scenarios.RegisterTest_TC2"/>
      <class name="com.hybridframework.practice.scenarios.SearchTest_TC3"/>
    </classes>
    
  </test> <!-- Test -->
  
</suite> <!-- Suite -->
