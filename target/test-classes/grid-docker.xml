<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">


<suite name="dockerSuite" thread-count="5">
	
  <listeners>
	  <listener class-name="com.demowebshop.listeners.ExtentReportManager" />
  </listeners>
  
  <test name="Linux-Chrome">
     <parameter name="browser" value="chrome"/>
     <parameter name="operatingSystem" value="Linux"/>
     
    <classes>
           <class name="com.hybridframework.practice.scenarios.SearchTest_TC3"/> 
    </classes>
  </test> 
  
 

 <test name="Linux-Firefox">
    <parameter name="browser" value="firefox"/>
    <parameter name="operatingSystem" value="Linux"/>
     
    <classes>
            <class name="com.hybridframework.practice.scenarios.SearchTest_TC3"/> 
    		 
    </classes>
  </test>
  
  
</suite> <!-- Suite -->