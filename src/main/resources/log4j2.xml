<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
 
  <!-- Define properties -->
  <Properties>
    <Property name="basePath">./logs</Property>
  </Properties>

  <Appenders>
    <!-- Console Appender -->
    <Console name="Console" target="SYSTEM_OUT">
     
        <PatternLayout pattern ="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
    </Console>

    <!-- Rolling File Appender using properties -->
    <RollingFile name="File" fileName="${basePath}/automation.log" 
    filePattern="${basePath}/automation-%d{yyyy-MM-dd}.log">
       <PatternLayout Pattern="%d{HH:mm:ss.SSS} [%t] %-5level %loggger{36} - %msg%n"/>
         <SizeBasedTriggeringPolicy size="6000"/>
         </RollingFile>


  </Appenders>

  <Loggers>
    <!-- Root logger references the console and rolling appenders -->
    <Root level="INFO">             <!--/ALL<TRACE<DEBUG<INFO<WARN<ERROR<FATAL<OFF-->
      <AppenderRef ref="File"/> 
       <AppenderRef ref="Console"/>   <!--<AppenderRef ref="Console , File"/> -->
    </Root>
  </Loggers>

</Configuration>